# Environnement de développement. Ne mettez JAMAIS de vrais secrets ici : utilisez un fichier .env.local.
APP_ENV=dev
APP_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire

# Base de données : SQLite pour démarrer vite.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# MySQL      : DATABASE_URL="mysql://user:motdepasse@127.0.0.1:3306/dab?serverVersion=8.0&charset=utf8mb4"
# PostgreSQL : DATABASE_URL="postgresql://user:motdepasse@127.0.0.1:5432/dab?serverVersion=16&charset=utf8"

# E-mails. En développement : Mailpit (https://mailpit.axllent.org) écoute sur le port 1025, interface sur http://localhost:8025
MAILER_DSN=smtp://127.0.0.1:1025
MAIL_FROM=no-reply@dab-boutique.fr
# Boîte qui reçoit les messages du formulaire de contact
CONTACT_EMAIL=contact@dab-boutique.fr

# Adresse du site React (redirection après confirmation de l'e-mail) et de cette API (liens dans les e-mails)
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000

# Origines autorisées à appeler l'API depuis un navigateur (expression régulière)
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# Paiement Stripe (Checkout hébergé par Stripe). Laissez STRIPE_SECRET_KEY VIDE pour désactiver le paiement en ligne :
# les commandes sont alors enregistrées sans paiement, comme avant. Les clés se trouvent dans Stripe > Développeurs > Clés API.
# Mettez les vraies valeurs dans .env.local (jamais dans ce fichier) : sk_test_… en test, sk_live_… en production.
STRIPE_SECRET_KEY=
# Secret du webhook (whsec_…) : Stripe > Développeurs > Webhooks (URL : API_PUBLIC_URL/api/payments/webhook),
# ou en local `stripe listen --forward-to localhost:8000/api/payments/webhook` qui l'affiche.
STRIPE_WEBHOOK_SECRET=
# Pays où vous livrez (codes ISO séparés par des virgules) : Stripe demande l'adresse de livraison au client
STRIPE_SHIPPING_COUNTRIES=FR
# Frais de port (facultatif) : identifiant d'un tarif d'expédition créé dans Stripe (shr_…). Vide = pas de frais de port ajoutés.
STRIPE_SHIPPING_RATE_ID=

# Connexion avec un compte Google / Facebook (OAuth). Un fournisseur dont l'identifiant est VIDE est simplement masqué sur le site.
# Adresse de retour à déclarer chez le fournisseur : API_PUBLIC_URL/api/auth/oauth/google/callback (ou .../facebook/callback).
# Mettez les vraies valeurs dans .env.local (jamais dans ce fichier).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Version de l'API Graph de Facebook (Facebook retire les anciennes versions au bout de ~2 ans : à mettre à jour de temps en temps)
FACEBOOK_GRAPH_VERSION=v23.0

# Durées de validité
API_TOKEN_TTL_DAYS=7
VERIFICATION_TTL_HOURS=24
