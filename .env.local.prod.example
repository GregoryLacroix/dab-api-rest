# À copier sur le SERVEUR sous le nom .env.local (jamais dans le dépôt, jamais envoyé à d'autres personnes).
# Les adresses (FRONTEND_URL, API_PUBLIC_URL, CORS_ALLOW_ORIGIN) sont déjà dans .env.prod.

APP_ENV=prod
APP_DEBUG=0
# Longue chaîne aléatoire, à générer une fois : php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=

# Base de données (exemple MySQL ; les identifiants sont ceux créés dans l'espace PlanetHoster)
DATABASE_URL="mysql://UTILISATEUR:MOT_DE_PASSE@127.0.0.1:3306/NOM_BASE?serverVersion=8.0&charset=utf8mb4"

# E-mails : serveur SMTP d'une boîte de votre domaine (adresse d'expédition à créer chez PlanetHoster)
MAILER_DSN=smtp://UTILISATEUR:MOT_DE_PASSE@SERVEUR_SMTP:587
MAIL_FROM=no-reply@gregory-lacroix-pf.com
# Boîte qui reçoit les messages du formulaire de contact et les alertes « nouvelle commande payée »
CONTACT_EMAIL=

# Paiement Stripe (clés « live » : sk_live_… / whsec_… du webhook https://dab.api.gregory-lacroix-pf.com/api/payments/webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SHIPPING_COUNTRIES=FR
STRIPE_SHIPPING_RATE_ID=

# Connexion Google / Facebook (laisser vide = bouton masqué)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
