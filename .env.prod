# Valeurs de PRODUCTION qui ne sont pas des secrets (chargé quand APP_ENV=prod).
# Les secrets (APP_SECRET, base de données, e-mails, Stripe, Google/Facebook) vont dans .env.local sur le serveur :
# voir .env.local.prod.example.

# Adresse du site React (liens des e-mails, retour de Stripe et de Google/Facebook) et de cette API (images, adresses de retour OAuth)
FRONTEND_URL=https://dab.gregory-lacroix-pf.com
API_PUBLIC_URL=https://dab.api.gregory-lacroix-pf.com

# Seul le site de production peut appeler l'API depuis un navigateur (expression régulière)
CORS_ALLOW_ORIGIN='^https://dab\.gregory-lacroix-pf\.com$'
