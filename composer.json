{
    "name": "dab/boutique-api",
    "description": "API REST de la boutique D.A.B (Symfony)",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^2.15",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.3",
        "nelmio/cors-bundle": "^2.5",
        "setasign/fpdf": "^1.8",
        "stripe/stripe-php": "^17.0",
        "symfony/console": "^7.3",
        "symfony/dotenv": "^7.3",
        "symfony/framework-bundle": "^7.3",
        "symfony/http-client": "^7.3",
        "symfony/mailer": "^7.3",
        "symfony/mime": "^7.3",
        "symfony/rate-limiter": "^7.3",
        "symfony/runtime": "^7.3",
        "symfony/security-bundle": "^7.3",
        "symfony/string": "^7.3",
        "symfony/validator": "^7.3",
        "symfony/var-exporter": "^7.3"
    },
    "require-dev": {
        "symfony/maker-bundle": "^1.62"
    },
    "config": {
        "allow-plugins": { "symfony/runtime": true },
        "sort-packages": true
    },
    "autoload": { "psr-4": { "App\\": "src/" } }
}
